<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout

    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    >


    <TextView
        android:id="@+id/consola"
        android:gravity="bottom|end"
        android:textSize="70sp"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:textColor="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@color/black"
        android:orientation="vertical"
        />


    <GridLayout
        android:background="@color/black"
        android:id="@+id/mi_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:rowCount="6"
        android:columnCount="4"
        app:layout_constraintTop_toBottomOf="@id/consola"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" >



        <Button
            android:id="@+id/mrest"
            style="@style/botones"
            android:layout_row="1"
            android:text="M-"
            android:backgroundTint="@color/gray"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/mplus"
            style="@style/botones"
            android:layout_row="1"
            android:backgroundTint="@color/gray"
            android:text="M+"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/mc"
            style="@style/botones"
            android:layout_row="1"
            android:backgroundTint="@color/gray"
            android:text="Mc"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/mr"
            style="@style/botones"
            android:backgroundTint="@color/orange"
            android:text="Mr"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            style="@style/botones"
            android:id="@+id/num1"
            android:backgroundTint="@color/graydark"
            android:text="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            style="@style/botones"
            android:id="@+id/num2"
            android:backgroundTint="@color/graydark"
            android:text="2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            style="@style/botones"
            android:id="@+id/num3"
            android:backgroundTint="@color/graydark"
            android:text="3"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageButton
            android:src="@drawable/multiplicacion"
            android:background="@drawable/boton_redondo_naranja"
            style="@style/botones"

            android:id="@+id/multiply"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            style="@style/botones"
            android:id="@+id/num4"
            android:backgroundTint="@color/graydark"
            android:text="4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            style="@style/botones"
            android:id="@+id/num5"
            android:backgroundTint="@color/graydark"
            app:layout_constraintBottom_toBottomOf="parent"
            android:text="5"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            style="@style/botones"
            android:id="@+id/num6"
            android:text="6"
            android:backgroundTint="@color/graydark"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageButton
            style="@style/botones"
            android:src="@drawable/division"
            android:background="@drawable/boton_redondo_naranja"
            android:id="@+id/divide"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            style="@style/botones"
            android:id="@+id/num7"
            android:text="7"
            android:backgroundTint="@color/graydark"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            style="@style/botones"
            android:id="@+id/num8"
            android:text="8"
            android:backgroundTint="@color/graydark"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            style="@style/botones"
            android:id="@+id/num9"
            android:text="9"
            android:backgroundTint="@color/graydark"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageButton
            android:src="@drawable/suma"
            android:background="@drawable/boton_redondo_naranja"
            style="@style/botones"
            android:id="@+id/sum"
            android:text="+"
            android:backgroundTint="@color/orange"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageButton
            style="@style/botones"
            android:src="@drawable/borrar"
            android:id="@+id/clear"
            android:background="@drawable/boton_redondo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:clickable="true"
            />


        <Button
            style="@style/botones"
            android:id="@+id/num0"
            android:text="0"
            android:backgroundTint="@color/graydark"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            style="@style/botones"
            android:id="@+id/dot"
            android:text="."
            android:backgroundTint="@color/graydark"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageButton
            style="@style/botones"
            android:src="@drawable/resta"
            android:background="@drawable/boton_redondo"

            android:id="@+id/rest"
            android:text="-"
            android:backgroundTint="@color/orange"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageButton
            android:id="@+id/result"
            style="@style/botones"
            android:src="@drawable/igual"
            android:background="@drawable/boton_redondo_naranja"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


    </GridLayout>


</androidx.constraintlayout.widget.ConstraintLayout >
