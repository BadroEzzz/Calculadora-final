<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout

    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@color/black"
    >


    <TextView
        android:id="@+id/consola"
        android:gravity="bottom|end"
        android:textSize="70sp"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:textColor="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@color/black"
        android:orientation="vertical"
        />


    <GridLayout
        android:background="@color/black"
        android:id="@+id/mi_grid"
        android:layout_width="650dp"
        android:layout_height="270dp"
        android:orientation="horizontal"
        android:rowCount="4"
        android:columnCount="7"
        app:layout_constraintTop_toBottomOf="@id/consola"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" >
        >

        <Button
            style="@style/botonesland"
            android:id="@+id/num1"
            android:backgroundTint="@color/graydark"
            android:text="@string/num1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            style="@style/botonesland"
            android:id="@+id/num2"
            android:backgroundTint="@color/graydark"
            android:text="@string/num2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            style="@style/botonesland"
            android:id="@+id/num3"
            android:backgroundTint="@color/graydark"
            android:text="@string/num3"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <ImageButton
            style="@style/botonesland"
            android:src="@drawable/resta"
            android:background="@drawable/boton_redondo"

            android:id="@+id/rest"
            android:text="@string/resta"
            android:backgroundTint="@color/orange"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <ImageButton
            style="@style/botonesland"
            android:src="@drawable/division"
            android:background="@drawable/boton_redondo_naranja"
            android:id="@+id/divide"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/mrest"
            style="@style/botonesland"
            android:text="@string/Mmenos"
            android:backgroundTint="@color/gray"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <Button
            android:id="@+id/mplus"
            style="@style/botonesland"
            android:backgroundTint="@color/gray"
            android:text="@string/Mplus"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            style="@style/botonesland"
            android:id="@+id/num4"
            android:backgroundTint="@color/graydark"
            android:text="@string/num4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <Button
            style="@style/botonesland"
            android:id="@+id/num5"
            android:backgroundTint="@color/graydark"
            app:layout_constraintBottom_toBottomOf="parent"
            android:text="@string/num5"
            app:layout_constraintEnd_toEndOf="parent" />


        <Button
            style="@style/botonesland"
            android:id="@+id/num6"
            android:text="@string/num6"
            android:backgroundTint="@color/graydark"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <ImageButton
            android:src="@drawable/suma"
            android:background="@drawable/boton_redondo_naranja"
            style="@style/botonesland"
            android:id="@+id/sum"
            android:text="@string/suma"
            android:backgroundTint="@color/orange"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />



        <ImageButton
            android:src="@drawable/multiplicacion"
            android:background="@drawable/boton_redondo_naranja"
            style="@style/botonesland"

            android:id="@+id/multiply"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <Button
            android:id="@+id/mc"
            style="@style/botonesland"
            android:layout_row="1"
            android:backgroundTint="@color/gray"
            android:text="@string/Mc"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/mr"
            style="@style/botonesland"
            android:backgroundTint="@color/gray"
            android:text="@string/Mr"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            style="@style/botonesland"
            android:id="@+id/num7"
            android:text="@string/num7"
            android:backgroundTint="@color/graydark"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            style="@style/botonesland"
            android:id="@+id/num8"
            android:text="@string/num8"
            android:backgroundTint="@color/graydark"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            style="@style/botonesland"
            android:id="@+id/num9"
            android:text="@string/num9"
            android:backgroundTint="@color/graydark"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />




        <Button
            style="@style/botonesland"
            android:id="@+id/num0"
            android:text="@string/num0"
            android:backgroundTint="@color/graydark"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <Button
            style="@style/botonesland"
            android:id="@+id/dot"
            android:text="@string/dot"
            android:backgroundTint="@color/graydark"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <ImageButton
            style="@style/botonesland"
            android:src="@drawable/borrar"
            android:id="@+id/clear"
            android:background="@drawable/boton_redondo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:clickable="true"
            />



        <ImageButton
            android:id="@+id/result"
            style="@style/botonesland"
            android:src="@drawable/igual"
            android:background="@drawable/boton_redondo_naranja"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


    </GridLayout>


</androidx.constraintlayout.widget.ConstraintLayout >
